#Basic support
CONFIG_SYSVIPC=y
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_USB_ACM=y

#custom
CONFIG_DEFAULT_HOSTNAME="kali"
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n

#NH
CONFIG_NETHUNTER_SUPPORT=y
CONFIG_NETHUNTER_WIFI_SUPPORT=y
CONFIG_NETHUNTER_SDR_SUPPORT=y
CONFIG_NETHUNTER_USB_SUPPORT=y
CONFIG_NETHUNTER_NFS_SUPPORT=y

#network
CONFIG_CFG80211_WEXT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBPA10X=y
CONFIG_BT_HCIBFUSB=y
CONFIG_BT_HCIVHCI=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y


#RFCOMM
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=n
CONFIG_BT_HIDP=n
CONFIG_BT_HS=y

#USB
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y

#NFS
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFSD=y
CONFIG_NFSD_V3=y
CONFIG_NFSD_V4=y

#SDR
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_USB_AIRSPY=y
CONFIG_USB_HACKRF=y
CONFIG_USB_MSI2500=y
CONFIG_DVB_RTL2830=y
CONFIG_DVB_RTL2832=y
CONFIG_DVB_RTL2832_SDR=y
CONFIG_DVB_SI2168=y
CONFIG_DVB_ZD1301_DEMOD=y
